# mount_point   fstype  device                  [device2]                       [flags]
/boot           emmc    /dev/block/boot                                         flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/recovery                                     flags=display="Recovery";backup=1;flashimg=1
/logo           emmc    /dev/block/logo                                         flags=display="Logo";backup=1;flashimg=1
/dtbo           emmc    /dev/block/dtbo                                         flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/vbmeta                                       flags=display="VBMeta";backup=1;flashimg=1
/bootloader     emmc    /dev/block/bootloader                                   flags=display="Bootloader";backup=1
/misc           emmc    /dev/block/misc                                         flags=display="Misc"
/system         ext4    /dev/block/system                                       flags=display="System";backup=1;wipeingui
/system_image   emmc    /dev/block/system                                       flags=display="System Image";backup=0;flashimg=1
/vendor         ext4    /dev/block/vendor                                       flags=display="Vendor";backup=1;wipeingui
/vendor_image   emmc    /dev/block/vendor                                       flags=display="Vendor Image";backup=0;flashimg=1
/odm            ext4    /dev/block/odm                                          flags=display="ODM";backup=1
/product        ext4    /dev/block/product                                      flags=display="Product";backup=1
/cache          ext4    /dev/block/cache                                        flags=display="Cache";wipeingui
/data           ext4    /dev/block/data                                         flags=display="Data";wipeingui;length=-16384
/metadata       ext4    /dev/block/metadata                                     flags=display="Metadata"
/swdb           emmc    /dev/block/swdb                                         flags=display="SWDB";backup=1
/udisk          auto    /dev/block/sda1         /dev/block/sda                  flags=display="U盘 (USB Storage)";storage;wipeingui;removable
